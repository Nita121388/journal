{
  "manifest_version": 3,
  "name": "Journal 日志",
  "version": "0.1.0",
  "description": "记录每天干了什么：每日日志 + 热力图打卡 + TODO，AI 自然语言增删改查，数据全在本地。",
  "permissions": [
    "storage",
    "sidePanel",
    "alarms",
    "unlimitedStorage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Journal 日志",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+J",
        "mac": "MacCtrl+Shift+J"
      },
      "description": "打开 Journal 侧边栏"
    }
  }
}