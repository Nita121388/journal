# Node
node_modules/
dist/
build/
*.tsbuildinfo

# Env / secrets
.env
.env.local
*.pem

# OS
.DS_Store

# Logs
*.log
npm-debug.log*

# Host data (user privacy)
host/data/
# 日志数据备份（含隐私，不进公开仓库；日志备份走私有仓库 journal-data）
backup/

# Editor
.idea/
.vscode/
*.swp

# Trellis local-only state
.trellis/.developer
.trellis/.runtime/
.trellis/.template-hashes.json
.trellis/workspace/
# 注意：tasks/archive/ 不要忽略，归档任务需追踪（方便协作 + 复盘）
# 只忽略缓存、worktrees、备份等
.trellis/.backup-*
.trellis/worktrees/
.trellis/.cache/
