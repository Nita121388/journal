{
  "manifest_version": 3,
  "name": "Journal",
  "key": "",
  "version": "0.1.0",
  "description": "卡片式日程日志：时间线 / 待办 / 热力图打卡 / 到点提醒 / AI 增删改查",
  "permissions": ["storage", "sidePanel", "nativeMessaging", "alarms", "notifications"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "platform/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 Journal",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
